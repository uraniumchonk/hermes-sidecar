{
  "manifest_version": 3,
  "name": "Hermes Sidecar",
  "version": "0.6.1",
  "description": "Hermes Agent 的瀏覽器側掛面板：原生 Side Panel 直連 gateway API Server。",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage", "scripting", "tabs"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "開啟 Meow Agent 側邊欄"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
